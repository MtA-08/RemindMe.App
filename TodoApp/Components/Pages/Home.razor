@page "/"

@layout MainLayout
@inject TaskStorageService TaskStorage
@inject NavigationManager Navigation
@inject IStringLocalizer<RemindMe> Localizer

@using TodoApp.Services
@using Plugin.LocalNotification
@using Plugin.LocalNotification.Core.Models
@using System.Globalization


<PageTitle>Homepage</PageTitle>

<div class="task-card-page">

    <!-- Header -->
    <div class="page-header">
        <button class="round-btn btn-settings" @onclick="() => isSettingsMenuVisible = !isSettingsMenuVisible" title="Einstellungen">
            <img src="settings.svg" width="24" height="24" />
        </button>

        <button class="round-btn btn-add-task" @onclick="ShowModal" title="Task erstellen">
            <img src="blue-plus.svg" width="24" height="24" />
        </button>
    </div>

    <!-- Task Cards Liste -->
    <div class="task-list">
        @foreach (var task in tasks)
        {
            <div class="task-card @(task.IsCompleted ? "task-completed" : "")" @onclick="() => OpenTaskDetail(task.Id)">
                <div class="task-info">
                    <p class="task-title">@task.Name</p>
                </div>

                <button class="round-btn complete-btn @(task.IsCompleted ? "is-checked" : "")"
                        @onclick="() => ToggleTaskCompletionAsync(task)"
                        @onclick:stopPropagation="true">
                    @if (task.IsCompleted)
                    {
                        <img src="check.svg" width="18" height="18">
                    }
                </button>
            </div>
        }
    </div>

    <!-- BOTTOM SHEET: EINSTELLUNGEN -->
    @if (isSettingsMenuVisible)
    {
        <div class="sheet-overlay @(isSettingsMenuClosing ? "closing" : "")"></div>
        <div class="bottom-sheet @(isSettingsMenuClosing ? "closing" : "")">

            <div class="sheet-header">
                <h3>@Localizer["SettingsMenuName"]</h3>
                <button class="close-btn" @onclick="CloseSettingsMenuAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                <div class="settings-options-list">
                    <div class="settings-option-card" @onclick="() => isLanguageSettingsMenuVisible = !isLanguageSettingsMenuVisible">
                        <div class="settings-option-info">
                            <p class="settings-option-title">@Localizer["SettingsMenuSettingLanguage"]</p>
                        </div>
                        <img src="chevron-right.svg"/>
                    </div>

                    <div class="settings-option-card">
                        <div class="settings-option-info">
                            <p class="settings-option-title">@Localizer["SettingsMenuSettingDesign"]</p>
                        </div>
                        <img src="chevron-right.svg" />
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- BOTTOM SHEET: EINSTELLUNGEN-Sprache -->
    @if (isLanguageSettingsMenuVisible)
    {
        <div class="sheet-overlay @(isLanguageSettingsMenuClosing ? "closing" : "")"></div>
        <div class="bottom-sheet @(isLanguageSettingsMenuClosing ? "closing" : "")">

            <div class="sheet-header">
                <h3>@Localizer["SettingsMenuSettingLanguage"]</h3>
                <button class="close-btn" @onclick="CloseLanguageSettingsMenuAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                <div class="settings-options-list">
                    <div class="settings-option-card" @onclick='() => ChangeLanguage("de-DE")'>
                        <div class="settings-option-info">
                            <p class="settings-option-title">Deutsch</p>
                        </div>
                    </div>
                    <div class="settings-option-card" @onclick='() => ChangeLanguage("en-US")'>
                        <div class="settings-option-info">
                            <p class="settings-option-title">English</p>
                        </div>
                    </div>
                    <div class="settings-option-card" @onclick='() => ChangeLanguage("tr-TR")'>
                        <div class="settings-option-info">
                            <p class="settings-option-title">Türkçe</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- BOTTOM SHEET: TASK ERSTELLEN -->
    @if (isModalVisible)
    {
        <div class="sheet-overlay @(isTaskModalClosing ? "closing" : "")"></div>
        <div class="bottom-sheet @(isTaskModalClosing ? "closing" : "")">

            <div class="sheet-header">
                <h3>@Localizer["TaskPopupName"]</h3>
                <button class="close-btn" @onclick="HideModalAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                <div class="input-group">
                    <label>@Localizer["TaskNameInputLabel"]</label>
                    <input type="text" @bind="newTask.Name" maxlength="@MaxTaskNameLength" class="text-input-field" placeholder="@Localizer["TaskNameInputPlaceholder"]" />
                </div>

                <div class="input-group">
                    <label>@Localizer["TaskDescriptionInputLabel"]</label>
                    <textarea @bind="newTask.Description" class="text-input-field textarea-field" placeholder=@Localizer["TaskDescriptionInputPlaceholder"]></textarea>
                </div>

                <div class="input-group">
                    <label>@Localizer["TaskReminderInputLabel"]</label>
                    <div class="select-menu-card" @onclick="ToggleReminderMenuAsync">
                        <div class="select-menu-left">
                            <img src="clock.svg" />
                            <span>@(newTask.Reminders.Count > 0 ? $"{newTask.Reminders.Count} {Localizer["TaskReminderInputPlaceholderMultipleReminders"]}" : Localizer["TaskReminderInputPlaceholderNoReminder"])</span>
                        </div>
                        <span class="action-link">@Localizer["TaskReminderInputAddButton"]</span>
                    </div>
                </div>
            </div>

            <div class="sheet-footer">
                <button class="save-btn-full" @onclick="SaveTaskAsync">
                    <img src="check.svg" alt="Erstellen" />
                    <span>@Localizer["TaskCreateTaskButton"]</span>
                </button>
            </div>
        </div>
    }

    <!-- BOTTOM SHEET: ERINNERUNGEN ERSTELLEN -->
    @if (isReminderMenuVisible)
    {
        <div class="sheet-overlay @(isReminderModalClosing ? "closing" : "")" @onclick="ToggleReminderMenuAsync"></div>
        <div class="bottom-sheet @(isReminderModalClosing ? "closing" : "")">

            <div class="sheet-header">
                <h3>@Localizer["TaskAddReminderPopupName"]</h3>
                <button class="close-btn" @onclick="ToggleReminderMenuAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                @if (notificationsEnabled)
                {
                    @foreach (var reminder in newTask.Reminders)
                    {
                        <div class="set-reminder-card">
                            <div class="reminder-menu-day-picker">
                                <button class="day-chip @(IsSingleDateSelected(reminder,DateOnly.FromDateTime(DateTime.Today))
                                                            ? "selected" : "")" @onclick="() => SetSingleReminderDate(reminder,DateOnly.FromDateTime(DateTime.Today))">
                                    @Localizer["TaskAddReminderReminderMenuToday"]
                                </button>
                                <button class="day-chip @(IsSingleDateSelected(reminder,DateOnly.FromDateTime(DateTime.Today.AddDays(1)))
                                                ? "selected"
                                                : "")"
                                                @onclick="() => SetSingleReminderDate(reminder,DateOnly.FromDateTime(DateTime.Today.AddDays(1)))">
                                    @Localizer["TaskAddReminderReminderMenuTomorrow"]
                                </button>
                                <button class="day-chip @(IsCustomDateSelection(reminder)? "selected": "")"
                                                        @onclick="() => OpenDaySelection(reminder)">
                                    @Localizer["TaskAddReminderReminderMenuPickDay"]
                                </button>
                            </div>
                            <div class="reminder-card-footer">
                                <div class="reminder-menu-time-picker" @onclick="() => EditReminderTime(reminder)">
                                    <img src="clock.svg" width="24" alt="Uhrzeit" />
                                    <input type="time" class="time-picker-input" @bind-value="TempTime" @bind-value:after="SaveTimeAsync" placeholder="@reminder.FormattedTime" />
                                </div>
                                <button class="reminder-delete-btn" @onclick="() => RemoveReminder(reminder)">
                                    <img src="red-trash.svg" width="18" alt="Löschen" />
                                </button>
                            </div>
                        </div>
                    }

                    <button class="add-reminder-btn" @onclick="AddNewReminder">
                        <img src="plus.svg" width="18" alt="Plus" />
                        <span>@Localizer["TaskAddReminderAddReminderButton"]</span>
                    </button>
                }
                else
                {
                    <div class="notification-permission-card">
                        <p>Benachrichtigungen sind zurzeit deaktiviert.</p>
                        <button class="ask-permission-button" @onclick="RequestNotificationPermission">
                            Benachrichtigungen erlauben
                        </button>
                    </div>
                }
            </div>

            <div class="sheet-footer">
                <button class="save-btn-full" @onclick="ToggleReminderMenuAsync">
                    <img src="check.svg" alt="Fertig" />
                    <span>@Localizer["TaskAddReminderDoneButton"]</span>
                </button>
            </div>
        </div>
    }

    <!-- BOTTOM SHEET: TAGE AUSWÄHLEN -->
    @if (daySelectionReminder != null)
    {
        <div class="sheet-overlay @(isDaySelectionClosing ? "closing" : "")"></div>
        <div class="bottom-sheet @(isDaySelectionClosing ? "closing" : "")">

            <div class="sheet-header">
                <h3>Tage auswählen</h3>
                <button class="close-btn" @onclick="CloseDaySelectionAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                <!-- Kalender Kopfzeile (Monatsnavigation) -->
                <div class="calendar-header" >
                    <button class="round-btn btn-back" @onclick="PrevMonth"><img src="chevron-left.svg" /></button>
                    <h4 style="margin: 0;">@calendarDisplayDate.ToString("MMMM yyyy")</h4>
                    <button class="round-btn btn-back" @onclick="NextMonth"><img src="chevron-right.svg" /></button>
                </div>

                <!-- Kalender Raster -->
                <div class="calendar-grid">
                    <!-- Wochentage -->
                    <div class="day-name">Mo</div><div class="day-name">Di</div>
                    <div class="day-name">Mi</div><div class="day-name">Do</div>
                    <div class="day-name">Fr</div><div class="day-name">Sa</div>
                    <div class="day-name">So</div>

                    <!-- Leere Felder für den Monatsanfang -->
                    @for (int i = 0; i < GetEmptyDaysAtStart(); i++)
                    {
                        <div></div>
                    }

                    <!-- Eigentliche Tage -->
                    @for (int d = 1; d <= DateTime.DaysInMonth(calendarDisplayDate.Year, calendarDisplayDate.Month); d++)
                    {
                        var date = new DateOnly(
                            calendarDisplayDate.Year,
                            calendarDisplayDate.Month,
                            d);

                        bool isSelected =
                            selectedDatesDraft.Contains(date);

                        <button class="day-chip @(isSelected ? "selected" : "")"
                                @onclick="() => ToggleDate(date)">
                            @d
                        </button>
                    }
                </div>
            </div>
            <div class="sheet-footer">
                <button class="save-btn-full"
                        disabled="@(selectedDatesDraft.Count == 0)"
                        @onclick="SaveDaySelectionAsync">
                    <span>Auswahl übernehmen</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const string TasksStorageKey = "myTasks";
    private const int MaxTaskNameLength = 24;
    private const int SheetAnimationDurationMs = 300;

    private List<TodoTask> tasks = new();
    private TodoTask newTask = new TodoTask();

    private bool isModalVisible = false;
    private bool isReminderMenuVisible = false;
    private bool isSettingsMenuVisible = false;

    private bool isLanguageSettingsMenuVisible = false;

    private Reminder? selectedReminder;
    private TimeOnly TempTime;
    private bool notificationsEnabled = false;
    private Reminder? daySelectionReminder;
    private bool isDaySelectionClosing = false;
    private DateTime calendarDisplayDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private bool isTaskModalClosing = false;
    private bool isReminderModalClosing = false;
    private bool isTimePickerClosing = false;
    private bool isSettingsMenuClosing = false;
    private bool isLanguageSettingsMenuClosing = false;




    // ==========================================
    // Modal Steuerung
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskStorage.LoadTasksAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            notificationsEnabled = await LocalNotificationCenter.Current.AreNotificationsEnabled();
            StateHasChanged();
        }
    }

    private void ShowModal()
    {
        newTask = new TodoTask();
        isModalVisible = true;
        isTaskModalClosing = false;
    }

    private async Task HideModalAsync()
    {
        isTaskModalClosing = true;
        StateHasChanged();
        await Task.Delay(SheetAnimationDurationMs);
        isModalVisible = false;
        isTaskModalClosing = false;
        newTask = new TodoTask();
    }

    private void OpenTaskDetail(string taskId)
    {
        Navigation.NavigateTo($"/task/{taskId}");
    }

    // ==========================================
    // Task Speicherung & Status
    // ==========================================

    private async Task SaveTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(newTask.Name)) return;

        string safeName = newTask.Name.Length > MaxTaskNameLength ? newTask.Name.Substring(0, MaxTaskNameLength) : newTask.Name;

        var createdTask = new TodoTask
        {
            Name = safeName,
            Description = newTask.Description,
            Reminders = newTask.Reminders
        };

        tasks.Add(createdTask);

        await ScheduleNotificationsForTaskAsync(createdTask);
        await TaskStorage.SaveTasksAsync(tasks);

        await HideModalAsync();
        StateHasChanged(); // Zwingt Blazor, die Liste neu zu rendern
    }

    private async Task ToggleTaskCompletionAsync(TodoTask task)
    {
        task.IsCompleted = !task.IsCompleted;
        await ScheduleNotificationsForTaskAsync(task);
        await TaskStorage.SaveTasksAsync(tasks);
    }

    // ==========================================
    // Erinnerungen & TimePicker
    // ==========================================

    private async Task ToggleReminderMenuAsync()
    {
        if (isReminderMenuVisible)
        {
            await CloseReminderMenuAsync();
        }
        else
        {
            isReminderMenuVisible = true;
            isReminderModalClosing = false;
        }
    }

    private async Task CloseReminderMenuAsync()
    {
        isReminderModalClosing = true;
        StateHasChanged();
        await Task.Delay(SheetAnimationDurationMs);
        isReminderMenuVisible = false;
        isReminderModalClosing = false;
    }

    private void AddNewReminder() => newTask.Reminders.Add(new Reminder());

    private void RemoveReminder(Reminder reminder) => newTask.Reminders.Remove(reminder);


    private void EditReminderTime(Reminder reminder)
    {
        selectedReminder = reminder;
        TempTime = reminder.Time;
    }

    private async Task SaveTimeAsync()
    {
        if (selectedReminder == null)
        {
            return;
        }

        selectedReminder.Time = TempTime;

        await CloseTimePickerAsync();
    }

    private async Task CloseTimePickerAsync()
    {
        isTimePickerClosing = true;
        StateHasChanged();
        await Task.Delay(SheetAnimationDurationMs);
        selectedReminder = null;
        isTimePickerClosing = false;
    }

    private List<DateOnly> selectedDatesDraft = new();

    // Öffnet das Fenster für die manuelle Tagesauswahl
    private void OpenDaySelection(Reminder reminder)
    {
        daySelectionReminder = reminder;

        selectedDatesDraft = new List<DateOnly>(reminder.Dates);
    }

    // ==========================================
    // Benachrichtigungen (LocalNotification)
    // ==========================================

    private async Task RequestNotificationPermission()
    {
        notificationsEnabled = await LocalNotificationCenter.Current.RequestNotificationPermission();
        StateHasChanged();
    }

    private async Task ScheduleNotificationsForTaskAsync(TodoTask task)
    {
        if (task.NotificationIds.Any())
        {
            LocalNotificationCenter.Current.Cancel(task.NotificationIds.ToArray());

            task.NotificationIds.Clear();
        }

        bool notificationsEnabled =
            await LocalNotificationCenter.Current.AreNotificationsEnabled();

        if (task.IsCompleted || !notificationsEnabled)
        {
            return;
        }

        foreach (Reminder reminder in task.Reminders)
        {
            foreach (DateOnly date in reminder.Dates)
            {
                DateTime notifyTime = date.ToDateTime(reminder.Time);

                // Keine Benachrichtigung mehr für vergangene Termine.
                if (notifyTime <= DateTime.Now)
                {
                    continue;
                }

                int notificationId = CreateUniqueNotificationId();

                task.NotificationIds.Add(notificationId);

                var request = new NotificationRequest
                {
                    NotificationId = notificationId,

                    Title = $"Erinnerung: {task.Name}",

                    Description = string.IsNullOrWhiteSpace(task.Description) ? "Es ist Zeit für deine Aufgabe!" : task.Description,
                    Schedule = new NotificationRequestSchedule
                    {
                        NotifyTime = notifyTime,
                        RepeatType = NotificationRepeat.No
                    }
                };

                await LocalNotificationCenter.Current.Show(request);
            }
        }
    }

    private int CreateUniqueNotificationId()
    {
        var usedIds = tasks
            .SelectMany(task => task.NotificationIds)
            .ToHashSet();

        int id;

        do
        {
            id = Random.Shared.Next(
                100_000,
                1_000_000);
        }
        while (usedIds.Contains(id));

        return id;
    }

    // ==========================================
    // Datum Wähler Kalender
    // ==========================================

    // Monatsnavigation
    private void PrevMonth()
    {
        calendarDisplayDate = calendarDisplayDate.AddMonths(-1);
    }

    private void NextMonth()
    {
        calendarDisplayDate = calendarDisplayDate.AddMonths(1);
    }

    // Berechnet die Einrückung für den ersten Tag des Monats im Raster
    private int GetEmptyDaysAtStart()
    {
        int dayOfWeek = (int)calendarDisplayDate.DayOfWeek;
        // C# Sonntag = 0, Montag = 1. Wir wollen Montag = 0 für das Raster:
        return dayOfWeek == 0 ? 6 : dayOfWeek - 1;
    }

    private bool IsSingleDateSelected(Reminder reminder,DateOnly date)
    {
        return reminder.Dates.Count == 1 && reminder.Dates.Contains(date);
    }

    private bool IsCustomDateSelection(Reminder reminder)
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);

        DateOnly tomorrow = today.AddDays(1);

        if (reminder.Dates.Count != 1)
        {
            return true;
        }

        DateOnly selectedDate = reminder.Dates[0];

        return selectedDate != today && selectedDate != tomorrow;
    }

    private void SetSingleReminderDate(Reminder reminder, DateOnly date)
    {
        reminder.Dates.Clear();
        reminder.Dates.Add(date);
    }

    private void ToggleDate(DateOnly date)
    {
        if (selectedDatesDraft.Contains(date))
        {
            selectedDatesDraft.Remove(date);
        }
        else
        {
            selectedDatesDraft.Add(date);
        }
    }

    private async Task SaveDaySelectionAsync()
    {
        if (daySelectionReminder == null || selectedDatesDraft.Count == 0)
        {
            return;
        }

        daySelectionReminder.Dates = selectedDatesDraft.Distinct().OrderBy(date => date).ToList();

        await CloseDaySelectionAsync();
    }

    private async Task CloseDaySelectionAsync()
    {
        isDaySelectionClosing = true;
        StateHasChanged();

        await Task.Delay(SheetAnimationDurationMs);

        daySelectionReminder = null;
        selectedDatesDraft.Clear();

        isDaySelectionClosing = false;
    }

    private void ChangeLanguage(string language)
    {
        var culture = new CultureInfo(language);

        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;
        CultureInfo.CurrentCulture = culture;
        CultureInfo.CurrentUICulture = culture;

        Preferences.Default.Set("selected_language", language);
    }

    private async Task CloseSettingsMenuAsync()
    {
        isSettingsMenuClosing = true;
        StateHasChanged();

        await Task.Delay(SheetAnimationDurationMs);
        isSettingsMenuVisible = false;

        isSettingsMenuClosing = false;
    }

    private async Task CloseLanguageSettingsMenuAsync()
    {
        isLanguageSettingsMenuClosing = true;
        StateHasChanged();

        await Task.Delay(SheetAnimationDurationMs);
        isLanguageSettingsMenuVisible = false;

        isLanguageSettingsMenuClosing = false;
    }
}