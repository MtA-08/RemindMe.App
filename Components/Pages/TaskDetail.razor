@page "/task/{Id}"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using System.Text.Json
@using Plugin.LocalNotification
@using Plugin.LocalNotification.Core.Models

<div class="task-detail-page">
    @if (task == null)
    {
        <div class="loading-state">
            <p>Aufgabe wird geladen...</p>
        </div>
    }
    else
    {
        <!-- Action Header -->
        <div class="detail-header-actions">
            <button class="round-btn btn-back" @onclick="GoBack" title="Zurück">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
            </button>

            <div class="right-actions">
                <button class="round-btn btn-edit" @onclick="OpenEditModal" title="Bearbeiten">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                </button>
                <button class="round-btn btn-delete" @onclick="DeleteTaskAsync" title="Löschen">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- ANSICHTS-MODUS -->
        <div class="detail-body">
            <div class="detail-block">
                <span class="field-label">NAME</span>
                <h1 class="field-value task-title">@task.Name</h1>
            </div>

            <div class="detail-block">
                <span class="field-label">BESCHREIBUNG</span>
                <p class="field-value description-text">
                    @(string.IsNullOrWhiteSpace(task.Description) ? "Keine Beschreibung vorhanden." : task.Description)
                </p>
            </div>

            <div class="detail-block">
                <span class="field-label">ERINNERUNGEN</span>
                @if (task.Reminders != null && task.Reminders.Any())
                {
                    <div class="reminders-list">
                        @foreach (var reminder in task.Reminders)
                        {
                            <div class="reminder-card">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                                <span class="reminder-days">
                                    @(reminder.Days != null && reminder.Days.Any() ? string.Join(", ", reminder.Days) : "Keine Tage")
                                </span>
                                <span class="reminder-time">
                                    @reminder.Hour.ToString("D2"):@reminder.Minute.ToString("D2")
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="field-value empty-text">Keine Erinnerungen eingestellt.</p>
                }
            </div>
        </div>

        <!-- BOTTOM SHEET: TASK BEARBEITEN -->
        @if (isModalVisible)
        {
            <div class="sheet-overlay @(isClosing ? "closing" : "")" @onclick="CloseEditModalAnimated"></div>
            <div class="bottom-sheet @(isClosing ? "closing" : "")"
                 style="transform: translateY(@(sheetOffsetY)px);"
                 @ontouchstart="OnTouchStart"
                 @ontouchmove="OnTouchMove"
                 @ontouchend="() => OnTouchEnd(CloseEditModalAnimated)">

                <div class="sheet-drag-handle-area">
                    <div class="drag-handle"></div>
                </div>

                <div class="sheet-header">
                    <h3>Task bearbeiten</h3>
                    <button class="close-btn" @onclick="CloseEditModalAnimated">
                        <img src="x.svg" alt="Schließen" />
                    </button>
                </div>

                <div class="sheet-content">
                    <div class="input-group">
                        <label>NAME</label>
                        <input type="text" @bind="newTask.Name" maxlength="24" class="text-input-field" placeholder="Task Name...">
                    </div>

                    <div class="input-group">
                        <label>BESCHREIBUNG</label>
                        <textarea @bind="newTask.Description" class="text-input-field textarea-field" placeholder="Beschreibung (optional)..."></textarea>
                    </div>

                    <div class="input-group">
                        <label>ERINNERUNGEN</label>
                        <div class="select-menu-card" @onclick="ToggleReminderMenu">
                            <div class="select-menu-left">
                                <img src="clock.svg" alt="Clock" width="18" />
                                <span>@(newTask.Reminders.Count > 0 ? $"{newTask.Reminders.Count} Erinnerung(en) aktiv" : "Keine Erinnerung")</span>
                            </div>
                            <span class="action-link">Konfigurieren</span>
                        </div>
                    </div>
                </div>

                <div class="sheet-footer">
                    <button class="save-btn-full" @onclick="SaveEditAsync">
                        <img src="check.svg" alt="Speichern" />
                        <span>Änderungen speichern</span>
                    </button>
                </div>
            </div>
        }

        <!-- BOTTOM SHEET: ERINNERUNGEN -->
        @if (isReminderMenuVisible)
        {
            <div class="sheet-overlay @(isClosing ? "closing" : "")" @onclick="ToggleReminderMenuAnimated"></div>
            <div class="bottom-sheet @(isClosing ? "closing" : "")"
                 style="transform: translateY(@(sheetOffsetY)px);"
                 @ontouchstart="OnTouchStart"
                 @ontouchmove="OnTouchMove"
                 @ontouchend="() => OnTouchEnd(ToggleReminderMenuAnimated)">

                <div class="sheet-drag-handle-area">
                    <div class="drag-handle"></div>
                </div>

                <div class="sheet-header">
                    <h3>Erinnerungen verwalten</h3>
                    <button class="close-btn" @onclick="ToggleReminderMenuAnimated">
                        <img src="x.svg" alt="Schließen" />
                    </button>
                </div>

                <div class="sheet-content">
                    @if (notificationsEnabled)
                    {
                        @foreach (var reminder in newTask.Reminders)
                        {
                            <div class="set-reminder-card">
                                <div class="reminder-menu-day-picker">
                                    <button class="day-chip @(reminder.Days.Count == 1 && reminder.Days.Contains("Heute") ? "selected" : "")"
                                            @onclick='() => SetReminderOption(reminder, "Heute")'>
                                        Heute
                                    </button>
                                    <button class="day-chip @(reminder.Days.Count == 1 && reminder.Days.Contains("Morgen") ? "selected" : "")"
                                            @onclick='() => SetReminderOption(reminder, "Morgen")'>
                                        Morgen
                                    </button>
                                    <button class="day-chip @(IsCustomDaysSelected(reminder) ? "selected" : "")"
                                            @onclick="() => OpenDaySelection(reminder)">
                                        Tag wählen
                                    </button>
                                </div>
                                <div class="reminder-card-footer">
                                    <div class="reminder-menu-time-picker" @onclick="() => EditReminderTime(reminder)">
                                        <img src="clock.svg" width="18" alt="Uhrzeit" />
                                        <span>@reminder.FormattedTime</span>
                                    </div>
                                    <button class="reminder-delete-btn" @onclick="() => RemoveReminder(reminder)">
                                        <img src="trash.svg" width="18" alt="Löschen" />
                                    </button>
                                </div>
                            </div>
                        }

                        <button class="add-reminder-btn" @onclick="AddNewReminder">
                            <img src="plus.svg" width="18" alt="Plus" />
                            <span>Erinnerung hinzufügen</span>
                        </button>
                    }
                    else
                    {
                        <div class="notification-permission-card">
                            <p>Benachrichtigungen sind zurzeit deaktiviert.</p>
                            <button class="ask-permission-button" @onclick="RequestNotificationPermission">
                                Benachrichtigungen erlauben
                            </button>
                        </div>
                    }
                </div>

                <div class="sheet-footer">
                    <button class="save-btn-full" @onclick="ToggleReminderMenuAnimated">
                        <img src="check.svg" alt="Fertig" />
                        <span>Fertig</span>
                    </button>
                </div>
            </div>
        }

        <!-- BOTTOM SHEET / MODAL: ZEITAUSWAHL -->
        @if (selectedReminder != null)
        {
            <div class="sheet-overlay @(isClosing ? "closing" : "")" @onclick="CloseTimePickerAnimated"></div>
            <div class="bottom-sheet compact-sheet @(isClosing ? "closing" : "")"
                 style="transform: translateY(@(sheetOffsetY)px);"
                 @ontouchstart="OnTouchStart"
                 @ontouchmove="OnTouchMove"
                 @ontouchend="() => OnTouchEnd(CloseTimePickerAnimated)">

                <div class="sheet-drag-handle-area">
                    <div class="drag-handle"></div>
                </div>

                <div class="sheet-header">
                    <h3>Uhrzeit auswählen</h3>
                    <button class="close-btn" @onclick="CloseTimePickerAnimated">
                        <img src="x.svg" alt="Schließen" />
                    </button>
                </div>

                <div class="sheet-content center-content">
                    <input type="time" class="time-picker-input" @bind="tempTime" />
                </div>

                <div class="sheet-footer">
                    <button class="save-btn-full" @onclick="SaveTimeAnimated">
                        <span>Uhrzeit übernehmen</span>
                    </button>
                </div>
            </div>
        }

        <!-- BOTTOM SHEET: TAGE AUSWÄHLEN -->
        @if (daySelectionReminder != null)
        {
            <div class="sheet-overlay @(isDaySelectionClosing ? "closing" : "")" @onclick="CloseDaySelectionAsync"></div>
            <div class="bottom-sheet @(isDaySelectionClosing ? "closing" : "")"
                 style="transform: translateY(@(sheetOffsetY)px);"
                 @ontouchstart="OnTouchStart"
                 @ontouchmove="OnTouchMove"
                 @ontouchend="@(() => OnTouchEnd(CloseDaySelectionAsync))">

                <div class="sheet-drag-handle-area">
                    <div class="drag-handle"></div>
                </div>

                <div class="sheet-header">
                    <h3>Tage auswählen</h3>
                    <button class="close-btn" @onclick="CloseDaySelectionAsync">
                        <img src="x.svg" alt="Schließen" />
                    </button>
                </div>

                <div class="sheet-content">
                    <!-- Kalender Kopfzeile (Monatsnavigation) -->
                    <div class="calendar-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <button class="round-btn btn-settings" @onclick="NextMonth"><img src="chevron-left.svg" /></button>
                        <h4 style="margin: 0;">@calendarDisplayDate.ToString("MMMM yyyy")</h4>
                        <button class="round-btn btn-settings" @onclick="NextMonth"><img src="chevron-right.svg" /></button>
                    </div>

                    <!-- Kalender Raster -->
                    <div class="calendar-grid" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; text-align: center;">
                        <!-- Wochentage -->
                        <div class="day-name">Mo</div><div class="day-name">Di</div>
                        <div class="day-name">Mi</div><div class="day-name">Do</div>
                        <div class="day-name">Fr</div><div class="day-name">Sa</div>
                        <div class="day-name">So</div>

                        <!-- Leere Felder für den Monatsanfang -->
                        @for (int i = 0; i < GetEmptyDaysAtStart(); i++)
                        {
                            <div></div>
                        }

                        <!-- Eigentliche Tage -->
                        @for (int d = 1; d <= DateTime.DaysInMonth(calendarDisplayDate.Year, calendarDisplayDate.Month); d++)
                        {
                            var date = new DateTime(calendarDisplayDate.Year, calendarDisplayDate.Month, d);
                            var dateStr = date.ToString("yyyy-MM-dd");
                            bool isSelected = daySelectionReminder != null && daySelectionReminder.Days.Contains(dateStr);

                            <button class="day-chip @(isSelected ? "selected" : "")"
                                    style="width: 100%; padding: 10px 0;"
                                    @onclick="() => ToggleDate(dateStr)">
                                @d
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private List<TodoTask> tasks = new();
    private TodoTask? task;
    private TodoTask newTask = new TodoTask();

    private bool isModalVisible = false;
    private bool isReminderMenuVisible = false;
    private Reminder? selectedReminder;
    private TimeOnly tempTime;
    private bool notificationsEnabled = false;
    private Reminder? daySelectionReminder;
    private bool isDaySelectionClosing = false;
    private DateTime calendarDisplayDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    // Animation & UI States
    private bool isClosing = false;
    private double touchStartY = 0;
    private double sheetOffsetY = 0;

    protected override async Task OnInitializedAsync()
    {
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "myTasks");
        if (!string.IsNullOrEmpty(json))
        {
            tasks = JsonSerializer.Deserialize<List<TodoTask>>(json) ?? new List<TodoTask>();
            task = tasks.FirstOrDefault(t => t.Id == Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            notificationsEnabled = await LocalNotificationCenter.Current.AreNotificationsEnabled();
            StateHasChanged();
        }
    }

    // ==========================================
    // Swipe-Down Gesten-Steuerung
    // ==========================================

    private void OnTouchStart(TouchEventArgs e)
    {
        touchStartY = e.Touches[0].ClientY;
        sheetOffsetY = 0;
    }

    private void OnTouchMove(TouchEventArgs e)
    {
        double currentY = e.Touches[0].ClientY;
        double deltaY = currentY - touchStartY;

        if (deltaY > 0)
        {
            sheetOffsetY = deltaY;
        }
    }

    private async Task OnTouchEnd(Func<Task> closeCallback)
    {
        if (sheetOffsetY > 100)
        {
            await closeCallback.Invoke();
        }
        else
        {
            sheetOffsetY = 0;
        }
    }

    // ==========================================
    // Animations-Hilfsmethode für Schließvorgänge
    // ==========================================

    private async Task AnimateClose(Action closeAction)
    {
        if (isClosing) return;
        isClosing = true;
        StateHasChanged();

        await Task.Delay(250); // Warten bis die Schließ-Animation durchgelaufen ist

        closeAction.Invoke();
        isClosing = false;
        sheetOffsetY = 0;
        StateHasChanged();
    }

    // ==========================================
    // Navigation & Bearbeitung
    // ==========================================

    private void GoBack() => Navigation.NavigateTo("/");

    private void OpenEditModal()
    {
        if (task != null)
        {
            newTask = new TodoTask
            {
                Name = task.Name,
                Description = task.Description,
                Reminders = task.Reminders.Select(r => new Reminder
                {
                    Id = r.Id,
                    Days = new List<string>(r.Days),
                    Hour = r.Hour,
                    Minute = r.Minute
                }).ToList()
            };
            sheetOffsetY = 0;
            isClosing = false;
            isModalVisible = true;
        }
    }

    private Task CloseEditModalAnimated() => AnimateClose(() => { isModalVisible = false; newTask = new TodoTask(); });

    private async Task SaveEditAsync()
    {
        if (task != null && !string.IsNullOrWhiteSpace(newTask.Name))
        {
            string safeName = newTask.Name.Length > 24 ? newTask.Name.Substring(0, 24) : newTask.Name;

            task.Name = safeName;
            task.Description = newTask.Description;
            task.Reminders = newTask.Reminders;

            await ScheduleNotificationsForTask(task);

            var json = JsonSerializer.Serialize(tasks);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myTasks", json);

            await CloseEditModalAnimated();
        }
    }

    private async Task DeleteTaskAsync()
    {
        if (task != null)
        {
            if (task.NotificationIds.Any())
            {
                LocalNotificationCenter.Current.Cancel(task.NotificationIds.ToArray());
            }

            tasks.Remove(task);
            var json = JsonSerializer.Serialize(tasks);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myTasks", json);

            Navigation.NavigateTo("/");
        }
    }

    // ==========================================
    // Erinnerungen & TimePicker
    // ==========================================

    private void ToggleReminderMenu()
    {
        sheetOffsetY = 0;
        isClosing = false;
        isReminderMenuVisible = !isReminderMenuVisible;
    }

    private Task ToggleReminderMenuAnimated()
    {
        if (isReminderMenuVisible)
        {
            return AnimateClose(() => isReminderMenuVisible = false);
        }
        else
        {
            ToggleReminderMenu();
            return Task.CompletedTask;
        }
    }

    private void AddNewReminder() => newTask.Reminders.Add(new Reminder());
    private void RemoveReminder(Reminder reminder) => newTask.Reminders.Remove(reminder);

    private void ToggleDay(Reminder reminder, string day)
    {
        if (reminder.Days.Contains(day))
            reminder.Days.Remove(day);
        else
            reminder.Days.Add(day);
    }

    private void EditReminderTime(Reminder reminder)
    {
        selectedReminder = reminder;
        tempTime = new TimeOnly(reminder.Hour, reminder.Minute);
        sheetOffsetY = 0;
        isClosing = false;
    }

    private Task SaveTimeAnimated()
    {
        if (selectedReminder != null)
        {
            selectedReminder.Hour = tempTime.Hour;
            selectedReminder.Minute = tempTime.Minute;
        }
        return CloseTimePickerAnimated();
    }

    private Task CloseTimePickerAnimated() => AnimateClose(() => selectedReminder = null);

    // Hilfsmethode zur Überprüfung, ob spezifische Tage (nicht Heute/Morgen) gewählt wurden
    private bool IsCustomDaysSelected(Reminder reminder)
    {
        return reminder.Days.Any(d => d != "Heute" && d != "Morgen");
    }

    // Setzt "Heute" oder "Morgen" und löscht alle anderen Tage
    private void SetReminderOption(Reminder reminder, string option)
    {
        reminder.Days.Clear();
        reminder.Days.Add(option);
    }

    // Öffnet das Fenster für die manuelle Tagesauswahl
    private void OpenDaySelection(Reminder reminder)
    {
        if (!IsCustomDaysSelected(reminder))
        {
            reminder.Days.Clear(); // Leert Heute/Morgen, damit der User frisch wählen kann
        }
        daySelectionReminder = reminder;
        sheetOffsetY = 0;
    }

    // Schließt das Auswahlfenster animiert
    private async Task CloseDaySelectionAsync()
    {
        // Falls der Benutzer alle Tage abwählt, setzen wir es als Fallback zurück auf "Heute"
        if (daySelectionReminder != null && daySelectionReminder.Days.Count == 0)
        {
            daySelectionReminder.Days.Add("Heute");
        }

        isDaySelectionClosing = true;
        StateHasChanged();
        await Task.Delay(250);
        daySelectionReminder = null;
        isDaySelectionClosing = false;
        sheetOffsetY = 0;
    }

    // ==========================================
    // Benachrichtigungen
    // ==========================================

    private async Task RequestNotificationPermission()
    {
        notificationsEnabled = await LocalNotificationCenter.Current.RequestNotificationPermission();
        StateHasChanged();
    }

    private DayOfWeek GetDayOfWeek(string dayStr) => dayStr switch
    {
        "Mo" => DayOfWeek.Monday,
        "Di" => DayOfWeek.Tuesday,
        "Mi" => DayOfWeek.Wednesday,
        "Do" => DayOfWeek.Thursday,
        "Fr" => DayOfWeek.Friday,
        "Sa" => DayOfWeek.Saturday,
        "So" => DayOfWeek.Sunday,
        _ => DayOfWeek.Monday
    };

    private DateTime GetNextOccurrence(DayOfWeek targetDay, int hour, int minute)
    {
        DateTime now = DateTime.Now;
        DateTime nextDate = now.Date.AddHours(hour).AddMinutes(minute);

        while (nextDate.DayOfWeek != targetDay || nextDate <= now)
        {
            nextDate = nextDate.AddDays(1);
        }
        return nextDate;
    }

    private async Task ScheduleNotificationsForTask(TodoTask task)
    {
        if (task.NotificationIds.Any())
        {
            LocalNotificationCenter.Current.Cancel(task.NotificationIds.ToArray());
            task.NotificationIds.Clear();
        }

        if (task.IsCompleted || !await LocalNotificationCenter.Current.AreNotificationsEnabled())
        {
            return;
        }

        foreach (var reminder in task.Reminders)
        {
            foreach (var dayStr in reminder.Days)
            {
                DateTime nextOccurrence;
                NotificationRepeat repeatType = NotificationRepeat.Weekly;

                // --- NEUE LOGIK FÜR HEUTE / MORGEN ---
                if (dayStr == "Heute")
                {
                    nextOccurrence = DateTime.Today.AddHours(reminder.Hour).AddMinutes(reminder.Minute);

                    // Falls die Uhrzeit für heute bereits vergangen ist, plane es für morgen ein
                    if (nextOccurrence <= DateTime.Now)
                    {
                        nextOccurrence = nextOccurrence.AddDays(1);
                    }
                    repeatType = NotificationRepeat.No; // Keine wöchentliche Wiederholung für einmalige "Heute" Tasks
                }
                else if (dayStr == "Morgen")
                {
                    nextOccurrence = DateTime.Today.AddDays(1).AddHours(reminder.Hour).AddMinutes(reminder.Minute);
                    repeatType = NotificationRepeat.No; // Keine Wiederholung
                }
                else if (DateTime.TryParseExact(dayStr, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime parsedDate))
                {
                    // Setze die Uhrzeit für das gewählte Datum
                    nextOccurrence = parsedDate.Date.AddHours(reminder.Hour).AddMinutes(reminder.Minute);
                    repeatType = NotificationRepeat.No; // Spezifische Daten wiederholen sich nicht wöchentlich

                    // Wenn das Datum + Uhrzeit bereits in der Vergangenheit liegt, überspringen wir die Erstellung
                    if (nextOccurrence <= DateTime.Now)
                    {
                        continue;
                    }
                }
                else
                {
                    // Fallback, falls noch alte "Mo", "Di" Einträge in der Datenbank hängen sollten
                    continue;
                }

                int notificationId = new Random().Next(100000, 999999);
                task.NotificationIds.Add(notificationId);

                var request = new NotificationRequest
                {
                    NotificationId = notificationId,
                    Title = "Erinnerung: " + task.Name,
                    Description = string.IsNullOrWhiteSpace(task.Description) ? "Es ist Zeit für deine Aufgabe!" : task.Description,
                    Schedule = new NotificationRequestSchedule
                    {
                        NotifyTime = nextOccurrence,
                        RepeatType = repeatType // Setzt dynamisch Weekly oder No
                    }
                };

                await LocalNotificationCenter.Current.Show(request);
            }
        }
    }

    // ==========================================
    // Datum Wähler Kalender
    // ==========================================

    // Monatsnavigation
    private void PrevMonth()
    {
        calendarDisplayDate = calendarDisplayDate.AddMonths(-1);
    }

    private void NextMonth()
    {
        calendarDisplayDate = calendarDisplayDate.AddMonths(1);
    }

    // Berechnet die Einrückung für den ersten Tag des Monats im Raster
    private int GetEmptyDaysAtStart()
    {
        int dayOfWeek = (int)calendarDisplayDate.DayOfWeek;
        // C# Sonntag = 0, Montag = 1. Wir wollen Montag = 0 für das Raster:
        return dayOfWeek == 0 ? 6 : dayOfWeek - 1;
    }

    // Speichert oder entfernt das gewählte Datum in der Reminder.Days Liste
    private void ToggleDate(string dateStr)
    {
        if (daySelectionReminder == null) return;

        if (daySelectionReminder.Days.Contains(dateStr))
        {
            daySelectionReminder.Days.Remove(dateStr);
        }
        else
        {
            // Wenn "Heute" oder "Morgen" drin stand, vorher leeren, da wir jetzt auf Datum-Modus wechseln
            if (daySelectionReminder.Days.Contains("Heute") || daySelectionReminder.Days.Contains("Morgen"))
            {
                daySelectionReminder.Days.Clear();
            }
            daySelectionReminder.Days.Add(dateStr);
        }
    }
}