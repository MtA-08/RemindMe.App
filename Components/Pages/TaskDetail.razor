@page "/task/{Id}"
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@using System.Text.Json
@using Plugin.LocalNotification


<div class="task-detail-page">
    @if (task == null)
    {
        <div class="loading-state">
            <p>Aufgabe wird geladen...</p>
        </div>
    }
    else
    {
        <!-- Action Header -->
        <div class="detail-header-actions">
            <!-- Zurück-Button (Links oben) -->
            <button class="round-btn btn-back" @onclick="GoBack" title="Zurück">
                <img src="chevron-left.svg" />
            </button>

            <!-- Rechter Button-Bereich (Bearbeiten / Löschen) -->
            @if (!isEditing)
            {
                <div class="right-actions">
                    <button class="round-btn btn-edit" @onclick="StartEditing" title="Bearbeiten">
                        <img src="edit.svg" />
                    </button>
                    <button class="round-btn btn-delete" @onclick="DeleteTask" title="Löschen">
                        <img src="red-trash.svg" />
                    </button>
                </div>
            }
            else
            {
                <div class="right-actions">
                    <button class="round-btn btn-cancel" @onclick="CancelEditing" title="Abbrechen">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                    <button class="round-btn btn-save" @onclick="SaveEdit" title="Speichern">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </button>
                </div>
            }
        </div>

        @if (!isEditing)
        {
            <!-- ANSICHTS-MODUS -->
            <div class="detail-body">
                <!-- Name Block -->
                <div class="detail-block">
                    <span class="field-label">NAME</span>
                    <h1 class="field-value task-title">@task.Name</h1>
                </div>

                <!-- Beschreibung Block -->
                <div class="detail-block">
                    <span class="field-label">BESCHREIBUNG</span>
                    <p class="field-value description-text">
                        @(string.IsNullOrWhiteSpace(task.Description) ? "Keine Beschreibung vorhanden." : task.Description)
                    </p>
                </div>

                <!-- Erinnerungen Block -->
                <div class="detail-block">
                    <span class="field-label">ERINNERUNGEN</span>
                    @if (task.Reminders != null && task.Reminders.Any())
                    {
                        <div class="reminders-list">
                            @foreach (var reminder in task.Reminders)
                            {
                                <div class="reminder-card">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span class="reminder-days">
                                        @(reminder.Days != null && reminder.Days.Any() ? string.Join(", ", reminder.Days) : "Keine Tage definiert")
                                    </span>
                                    <span class="reminder-time">
                                        @reminder.Hour.ToString("D2"):@reminder.Minute.ToString("D2")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="field-value empty-text">Keine Erinnerungen eingestellt.</p>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- BEARBEITUNGS-MODUS -->
            <div class="detail-body edit-mode">
                <div class="detail-block">
                    <label class="field-label">NAME BEARBEITEN</label>
                    <input type="text" @bind="editName" maxlength="24" class="custom-input" />
                </div>

                <div class="detail-block">
                    <label class="field-label">BESCHREIBUNG BEARBEITEN</label>
                    <textarea @bind="editDescription" class="custom-textarea" rows="4"></textarea>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private TodoTask? task;
    private List<TodoTask> tasks = new();

    // Variablen für den Bearbeitungsmodus
    private bool isEditing = false;
    private string editName = string.Empty;
    private string editDescription = string.Empty;
    private string editPriority = "-";

    protected override async Task OnInitializedAsync()
    {
        // Aufgaben aus dem LocalStorage laden (Key: "myTasks")
        var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "myTasks");

        if (!string.IsNullOrEmpty(json))
        {
            tasks = JsonSerializer.Deserialize<List<TodoTask>>(json) ?? new();
            task = tasks.FirstOrDefault(t => t.Id == Id);
        }
    }

    private void StartEditing()
    {
        if (task != null)
        {
            // Aktuelle Werte in die temporären Edit-Variablen laden
            editName = task.Name;
            editDescription = task.Description;
            editPriority = task.Priority;
            isEditing = true;
        }
    }

    private void CancelEditing()
    {
        isEditing = false;
    }

    private async Task SaveEdit()
    {
        if (task != null)
        {
            string safeName = editName;
            if (safeName.Length > 24) safeName = safeName.Substring(0, 24);

            // Werte auf die Aufgabe übertragen
            task.Name = safeName;
            task.Description = editDescription;
            task.Priority = editPriority;

            // In den LocalStorage speichern
            var json = JsonSerializer.Serialize(tasks);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myTasks", json);

            // Zurück in den Ansichts-Modus wechseln
            isEditing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteTask()
    {
        if (task != null)
        {
            // 1. Geplante Benachrichtigungen im Handy stoppen (falls vorhanden)
            if (task.NotificationIds != null && task.NotificationIds.Any())
            {
                try
                {
                    LocalNotificationCenter.Current.Cancel(task.NotificationIds.ToArray());
                }
                catch
                {
                    // Ignorieren, falls das System busy ist
                }
            }

            // 2. Aus der Liste entfernen
            tasks.Remove(task);

            // 3. Aktualisierte Liste speichern
            var json = JsonSerializer.Serialize(tasks);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myTasks", json);

            // 4. Zurück zur Startseite
            NavManager.NavigateTo("/");
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/");
    }
}