@page "/"
@layout MainLayout
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using System.Text.Json
@using System.Threading
@using Plugin.LocalNotification
@using Plugin.LocalNotification.Core.Models

<PageTitle>Homepage</PageTitle>

<div class="task-card-page">

    <!-- Header -->
    <div class="button-header">
        <button class="round-btn btn-settings" title="Einstellungen">
            <img src="settings.svg" width="24" height="24" />
        </button>

        <button class="round-btn btn-add-task" @onclick="ShowModal" title="Task erstellen">
            <img src="plus.svg" width="24" height="24" />
        </button>
    </div>

    <!-- Task Cards Liste -->
    <div class="task-list">
        @foreach (var task in tasks)
        {
            <div class="task-card @(task.IsCompleted ? "task-completed" : "")" @onclick="() => OpenTaskDetail(task.Id)">
                <div class="task-info">
                    <p class="task-title">@task.Name</p>
                </div>

                <button class="complete-btn @(task.IsCompleted ? "is-checked" : "")"
                        @onclick="() => ToggleTaskCompletionAsync(task)"
                        @onclick:stopPropagation="true">
                    @if (task.IsCompleted)
                    {
                        <img src="check.svg" width="18" height="18">
                    }
                </button>
            </div>
        }
    </div>

    <!-- BOTTOM SHEET: TASK ERSTELLEN -->
    @if (isModalVisible)
    {
        <div class="sheet-overlay @(isTaskModalClosing ? "closing" : "")" @onclick="HideModalAsync"></div>
        <div class="bottom-sheet @(isTaskModalClosing ? "closing" : "")"
             style="@GetSheetStyle(isTaskModalClosing)"
             @ontouchstart="OnTouchStart"
             @ontouchmove="OnTouchMove"
             @ontouchend="@(() => OnTouchEndAsync("Task"))">

            <!-- Handle-Balken oben zum Wischen -->
            <div class="sheet-drag-handle-area">
                <div class="drag-handle"></div>
            </div>

            <div class="sheet-header">
                <h3>Neues ToDo erstellen</h3>
                <button class="close-btn" @onclick="HideModalAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                <div class="input-group">
                    <label>NAME</label>
                    <input type="text" @bind="newTask.Name" maxlength="24" class="text-input-field" placeholder="Task Name..." />
                </div>

                <div class="input-group">
                    <label>BESCHREIBUNG</label>
                    <textarea @bind="newTask.Description" class="text-input-field textarea-field" placeholder="Beschreibung (optional)..."></textarea>
                </div>

                <div class="input-group">
                    <label>ERINNERUNGEN</label>
                    <div class="select-menu-card" @onclick="ToggleReminderMenuAsync">
                        <div class="select-menu-left">
                            <img src="clock.svg" alt="Clock" width="18" />
                            <span>@(newTask.Reminders.Count > 0 ? $"{newTask.Reminders.Count} Erinnerung(en) aktiv" : "Keine Erinnerung")</span>
                        </div>
                        <span class="action-link">Hinzufügen</span>
                    </div>
                </div>
            </div>

            <div class="sheet-footer">
                <button class="save-btn-full" @onclick="SaveTaskAsync">
                    <img src="check.svg" alt="Erstellen" />
                    <span>Task erstellen</span>
                </button>
            </div>
        </div>
    }

    <!-- BOTTOM SHEET: ERINNERUNGEN ERSTELLEN -->
    @if (isReminderMenuVisible)
    {
        <div class="sheet-overlay @(isReminderModalClosing ? "closing" : "")" @onclick="ToggleReminderMenuAsync"></div>
        <div class="bottom-sheet @(isReminderModalClosing ? "closing" : "")"
             style="@GetSheetStyle(isReminderModalClosing)"
             @ontouchstart="OnTouchStart"
             @ontouchmove="OnTouchMove"
             @ontouchend="@(() => OnTouchEndAsync("Reminder"))">

            <div class="sheet-drag-handle-area">
                <div class="drag-handle"></div>
            </div>

            <div class="sheet-header">
                <h3>Erinnerungen erstellen</h3>
                <button class="close-btn" @onclick="ToggleReminderMenuAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content">
                @if (notificationsEnabled)
                {
                    @foreach (var reminder in newTask.Reminders)
                    {
                        <div class="set-reminder-card">
                            <div class="reminder-menu-day-picker">
                                @foreach (var day in new[] { "Mo", "Di", "Mi", "Do", "Fr", "Sa", "So" })
                                {
                                    <button class="day-chip @(reminder.Days.Contains(day) ? "selected" : "")"
                                            @onclick="() => ToggleDay(reminder, day)">
                                        @day
                                    </button>
                                }
                            </div>
                            <div class="reminder-card-footer">
                                <div class="reminder-menu-time-picker" @onclick="() => EditReminderTime(reminder)">
                                    <img src="clock.svg" width="18" alt="Uhrzeit" />
                                    <span>@reminder.FormattedTime</span>
                                </div>
                                <button class="reminder-delete-btn" @onclick="() => RemoveReminder(reminder)">
                                    <img src="trash.svg" width="18" alt="Löschen" />
                                </button>
                            </div>
                        </div>
                    }

                    <button class="add-reminder-btn" @onclick="AddNewReminder">
                        <img src="plus.svg" width="18" alt="Plus" />
                        <span>Erinnerung hinzufügen</span>
                    </button>
                }
                else
                {
                    <div class="notification-permission-card">
                        <p>Benachrichtigungen sind zurzeit deaktiviert.</p>
                        <button class="ask-permission-button" @onclick="RequestNotificationPermission">
                            Benachrichtigungen erlauben
                        </button>
                    </div>
                }
            </div>

            <div class="sheet-footer">
                <button class="save-btn-full" @onclick="ToggleReminderMenuAsync">
                    <img src="check.svg" alt="Fertig" />
                    <span>Fertig</span>
                </button>
            </div>
        </div>
    }

    <!-- BOTTOM SHEET: ZEITWÄHLER -->
    @if (selectedReminder != null)
    {
        <div class="sheet-overlay @(isTimePickerClosing ? "closing" : "")" @onclick="CloseTimePickerAsync"></div>
        <div class="bottom-sheet compact-sheet @(isTimePickerClosing ? "closing" : "")"
             style="@GetSheetStyle(isTimePickerClosing)"
             @ontouchstart="OnTouchStart"
             @ontouchmove="OnTouchMove"
             @ontouchend="@(() => OnTouchEndAsync("Time"))">

            <div class="sheet-drag-handle-area">
                <div class="drag-handle"></div>
            </div>

            <div class="sheet-header">
                <h3>Uhrzeit auswählen</h3>
                <button class="close-btn" @onclick="CloseTimePickerAsync">
                    <img src="x.svg" alt="Schließen" />
                </button>
            </div>

            <div class="sheet-content center-content">
                <input type="time" class="time-picker-input" @bind="TempTime" />
            </div>

            <div class="sheet-footer">
                <button class="save-btn-full" @onclick="SaveTimeAsync">
                    <span>Uhrzeit übernehmen</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private List<TodoTask> tasks = new();
    private TodoTask newTask = new TodoTask();
    private bool isModalVisible = false;
    private bool isReminderMenuVisible = false;
    private Reminder? selectedReminder;
    private TimeOnly TempTime;
    private bool notificationsEnabled = false;

    // Animations- und Swipe-Zustände (Zusammengeführt ohne Duplikate)
    private double touchStartY = 0;
    private double sheetOffsetY = 0;
    private bool isDragging = false;

    private bool isTaskModalClosing = false;
    private bool isReminderModalClosing = false;
    private bool isTimePickerClosing = false;

    // ==========================================
    // Lifecycle & Modal Steuerung
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        string savedJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "myTasks");

        if (!string.IsNullOrEmpty(savedJson))
        {
            tasks = JsonSerializer.Deserialize<List<TodoTask>>(savedJson) ?? new List<TodoTask>();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            notificationsEnabled = await LocalNotificationCenter.Current.AreNotificationsEnabled();
            StateHasChanged();
        }
    }

    // ==========================================
    // Swipe-Down & Animations-Steuerung
    // ==========================================

    private string GetSheetStyle(bool isClosing)
    {
        if (isClosing) return "";
        if (isDragging) return $"transform: translateY({sheetOffsetY}px); transition: none;";
        return $"transform: translateY({sheetOffsetY}px); transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);";
    }

    private void OnTouchStart(TouchEventArgs e)
    {
        touchStartY = e.Touches[0].ClientY;
        sheetOffsetY = 0;
        isDragging = true;
    }

    private void OnTouchMove(TouchEventArgs e)
    {
        double currentY = e.Touches[0].ClientY;
        double deltaY = currentY - touchStartY;

        if (deltaY > 0)
        {
            sheetOffsetY = deltaY;
        }
    }

    private async Task OnTouchEndAsync(string modalType)
    {
        isDragging = false;
        if (sheetOffsetY > 120)
        {
            if (modalType == "Task") await HideModalAsync();
            else if (modalType == "Reminder") await CloseReminderMenuAsync();
            else if (modalType == "Time") await CloseTimePickerAsync();
        }
        else
        {
            sheetOffsetY = 0;
        }
    }

    private void ShowModal()
    {
        newTask = new TodoTask();
        sheetOffsetY = 0;
        isModalVisible = true;
        isTaskModalClosing = false;
    }

    private async Task HideModalAsync()
    {
        isTaskModalClosing = true;
        StateHasChanged();
        await Task.Delay(300);
        isModalVisible = false;
        isTaskModalClosing = false;
        sheetOffsetY = 0;
        newTask = new TodoTask();
    }

    private void OpenTaskDetail(string taskId)
    {
        Navigation.NavigateTo($"/task/{taskId}");
    }

    // ==========================================
    // Task Speicherung & Status
    // ==========================================

    private async Task SaveTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(newTask.Name)) return;

        string safeName = newTask.Name.Length > 24 ? newTask.Name.Substring(0, 24) : newTask.Name;

        var createdTask = new TodoTask
        {
            Name = safeName,
            Description = newTask.Description,
            Reminders = newTask.Reminders
        };

        tasks.Add(createdTask);

        await ScheduleNotificationsForTask(createdTask);
        await SaveDataToBrowser();

        await HideModalAsync();
        StateHasChanged(); // Zwingt Blazor, die Liste neu zu rendern
    }

    private async Task ToggleTaskCompletionAsync(TodoTask task)
    {
        task.IsCompleted = !task.IsCompleted;
        await ScheduleNotificationsForTask(task);
        await SaveDataToBrowser();
    }

    private async Task SaveDataToBrowser()
    {
        string json = JsonSerializer.Serialize(tasks);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "myTasks", json);
    }

    // ==========================================
    // Erinnerungen & TimePicker
    // ==========================================

    private async Task ToggleReminderMenuAsync()
    {
        if (isReminderMenuVisible)
        {
            await CloseReminderMenuAsync();
        }
        else
        {
            sheetOffsetY = 0;
            isReminderMenuVisible = true;
            isReminderModalClosing = false;
        }
    }

    private async Task CloseReminderMenuAsync()
    {
        isReminderModalClosing = true;
        StateHasChanged();
        await Task.Delay(300);
        isReminderMenuVisible = false;
        isReminderModalClosing = false;
        sheetOffsetY = 0;
    }

    private void AddNewReminder() => newTask.Reminders.Add(new Reminder());

    private void RemoveReminder(Reminder reminder) => newTask.Reminders.Remove(reminder);

    private void ToggleDay(Reminder reminder, string day)
    {
        if (reminder.Days.Contains(day))
            reminder.Days.Remove(day);
        else
            reminder.Days.Add(day);
    }

    private void EditReminderTime(Reminder reminder)
    {
        selectedReminder = reminder;
        TempTime = new TimeOnly(reminder.Hour, reminder.Minute);
        sheetOffsetY = 0;
    }

    private async Task SaveTimeAsync()
    {
        if (selectedReminder != null)
        {
            selectedReminder.Hour = TempTime.Hour;
            selectedReminder.Minute = TempTime.Minute;
            await CloseTimePickerAsync();
        }
    }

    private async Task CloseTimePickerAsync()
    {
        isTimePickerClosing = true;
        StateHasChanged();
        await Task.Delay(300);
        selectedReminder = null;
        isTimePickerClosing = false;
        sheetOffsetY = 0;
    }

    // ==========================================
    // Benachrichtigungen (LocalNotification)
    // ==========================================

    private async Task RequestNotificationPermission()
    {
        notificationsEnabled = await LocalNotificationCenter.Current.RequestNotificationPermission();
        StateHasChanged();
    }

    private DayOfWeek GetDayOfWeek(string dayStr)
    {
        return dayStr switch
        {
            "Mo" => DayOfWeek.Monday,
            "Di" => DayOfWeek.Tuesday,
            "Mi" => DayOfWeek.Wednesday,
            "Do" => DayOfWeek.Thursday,
            "Fr" => DayOfWeek.Friday,
            "Sa" => DayOfWeek.Saturday,
            "So" => DayOfWeek.Sunday,
            _ => DayOfWeek.Monday
        };
    }

    private DateTime GetNextOccurrence(DayOfWeek targetDay, int hour, int minute)
    {
        DateTime now = DateTime.Now;
        DateTime nextDate = now.Date.AddHours(hour).AddMinutes(minute);

        while (nextDate.DayOfWeek != targetDay || nextDate <= now)
        {
            nextDate = nextDate.AddDays(1);
        }
        return nextDate;
    }

    private async Task ScheduleNotificationsForTask(TodoTask task)
    {
        if (task.NotificationIds.Any())
        {
            LocalNotificationCenter.Current.Cancel(task.NotificationIds.ToArray());
            task.NotificationIds.Clear();
        }

        if (task.IsCompleted || !await LocalNotificationCenter.Current.AreNotificationsEnabled())
        {
            return;
        }

        foreach (var reminder in task.Reminders)
        {
            foreach (var dayStr in reminder.Days)
            {
                DayOfWeek targetDay = GetDayOfWeek(dayStr);
                DateTime nextOccurrence = GetNextOccurrence(targetDay, reminder.Hour, reminder.Minute);

                int notificationId = new Random().Next(100000, 999999);
                task.NotificationIds.Add(notificationId);

                var request = new NotificationRequest
                {
                    NotificationId = notificationId,
                    Title = "Erinnerung: " + task.Name,
                    Description = string.IsNullOrWhiteSpace(task.Description) ? "Es ist Zeit für deine Aufgabe!" : task.Description,
                    Schedule = new NotificationRequestSchedule
                    {
                        NotifyTime = nextOccurrence,
                        RepeatType = NotificationRepeat.Weekly
                    }
                };

                await LocalNotificationCenter.Current.Show(request);
            }
        }
    }
}